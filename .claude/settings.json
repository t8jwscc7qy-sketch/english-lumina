{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go run ./cmd/server:*)",
      "Bash(golangci-lint run:*)",
      "Bash(gofmt:*)",
      "Bash(sqlc generate:*)",
      "Bash(~/go/bin/oapi-codegen:*)",
      "Bash(goose -dir migrations status:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose up -d --wait:*)",
      "Bash(curl:*localhost*)",
      "Bash(curl:*127.0.0.1*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf:*)",
      "Bash(goose down:*)",
      "Bash(goose reset:*)",
      "Bash(dropdb:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)"
    ]
  },
  "model": "opusplan",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
