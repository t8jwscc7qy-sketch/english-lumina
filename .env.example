# Скопируй в .env и подставь свои значения. .env в git не попадает.

# PostgreSQL (контейнер из docker-compose)
POSTGRES_USER=english
POSTGRES_PASSWORD=change-me
POSTGRES_DB=english_pass
POSTGRES_PORT=5432

# Строка подключения для Go-сервера
DATABASE_URL=postgres://english:change-me@localhost:5432/english_pass?sslmode=disable

# Сервер
HTTP_ADDR=127.0.0.1:8080
